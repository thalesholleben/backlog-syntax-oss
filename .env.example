# Local-only development defaults. Replace every value outside local development.
API_HOST=0.0.0.0
API_PORT=8787
WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=https://backlog.syntaxlab.com.br
PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_API_URL=http://localhost:8787
AUTH_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=backlog_session
# Social login appears only when both server credentials and the public feature flag are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

POSTGRES_DB=backlog_syntax
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local-postgres-only
BACKLOG_OWNER_PASSWORD=local-owner-only
BACKLOG_AUTH_PASSWORD=local-auth-only
BACKLOG_APP_PASSWORD=local-app-only

AUTH_DATABASE_URL=postgresql://backlog_auth:local-auth-only@localhost:55432/backlog_syntax
APP_DATABASE_URL=postgresql://backlog_app:local-app-only@localhost:55432/backlog_syntax
DATABASE_SSL=false
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=5000

HOUSEKEEPING_ENABLED=true
HOUSEKEEPING_INTERVAL_MS=60000
