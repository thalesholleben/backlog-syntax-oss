{
  "name": "@backlog-syntax/mcp-oauth-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:down": "docker compose down -v --remove-orphans",
    "db:up": "docker compose up -d --wait",
    "probe:node": "node scripts/probe-node.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:docker": "node scripts/test-docker.mjs",
    "test:evidence": "vitest run --reporter=verbose",
    "test:integration": "vitest run test/oauth.integration.test.ts --reporter=verbose"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.2",
    "@better-auth/core": "1.7.2",
    "@better-auth/mcp": "1.7.2",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.1",
    "@modelcontextprotocol/server": "2.0.0",
    "better-auth": "1.7.2",
    "better-call": "1.4.0",
    "hono": "4.13.5",
    "jose": "6.2.3",
    "kysely": "0.29.0",
    "nanostores": "1.3.0",
    "pg": "8.16.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "8.15.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.30.0"
}
